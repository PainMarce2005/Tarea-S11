{
  "name": "tiendademo-unit-tests",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "../reports/jest",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
